{
  "name": "offline-cloudinary",
  "version": "2.2.2",
  "description": "An offline Cloudinary-like file manager with HTTP server emulator for local uploads, deletions, and testing without internet access.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "keywords": [
    "cloudinary",
    "offline",
    "upload",
    "local-storage",
    "mock",
    "testing",
    "file-system",
    "nodejs",
    "express",
    "server",
    "emulator",
    "http",
    "file-upload"
  ],
  "author": "Max Essien",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxEssien/offline-cloudinary"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/MaxEssien/offline-cloudinary/issues"
  },
  "homepage": "https://github.com/MaxEssien/offline-cloudinary#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "file-type": "^21.3.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ffprobe": "^1.1.8",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^25.5.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.2"
  }
}
